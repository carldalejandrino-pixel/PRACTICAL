<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Medical Record"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID" />

        <EditText
            android:id="@+id/etMedicalStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter registered student ID"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnLoadMedicalRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Existing Record" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allergies"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter allergies or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medical Conditions" />

        <EditText
            android:id="@+id/etConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter known conditions or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medications" />

        <EditText
            android:id="@+id/etMedications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter medications or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Additional Notes" />

        <EditText
            android:id="@+id/etMedicalNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter additional information"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveMedicalRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Medical Record" />

        <Button
            android:id="@+id/btnMedicalBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back" />

    </LinearLayout>
</ScrollView>
