<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fontFamily="@font/nimbus_roman">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MCSC"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MANAGE MEDICAL RECORD"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter a registered student's ID to manage their medical information."
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textColor="#173B6C"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etMedicalStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter registered student ID"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <Button
            android:id="@+id/btnLoadMedicalRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#173B6C"
            android:text="Load Existing Record"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allergies"
            android:textColor="#173B6C"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter allergies or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medical Conditions"
            android:textColor="#173B6C" />

        <EditText
            android:id="@+id/etConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter known conditions or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medications"
            android:textColor="#173B6C" />

        <EditText
            android:id="@+id/etMedications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter medications or None"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:layout_marginBottom="8dp"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Additional Notes"
            android:textColor="#173B6C" />

        <EditText
            android:id="@+id/etMedicalNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter additional information"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <Button
            android:id="@+id/btnSaveMedicalRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:backgroundTint="#173B6C"
            android:text="Save Medical Record"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

        <Button
            android:id="@+id/btnMedicalBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#173B6C"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

    </LinearLayout>
</ScrollView>
