<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fontFamily="@font/nimbus_roman">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MCSC"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT IDENTIFICATION"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter a registered student's ID to view their information."
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textColor="#173B6C"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter registered student ID"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <Button
            android:id="@+id/btnSearchStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#173B6C"
            android:text="Search Student"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT INFORMATION"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStudentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:text="Student information will appear here after searching."
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#173B6C"
            android:text="Back to Home"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

    </LinearLayout>
</ScrollView>
