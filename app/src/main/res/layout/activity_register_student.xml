<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:fontFamily="@font/nimbus_roman">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MCSC"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT REGISTRATION"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#173B6C"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the student's information below."
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textColor="#173B6C"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter student ID"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#173B6C"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter full name"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grade and Section"
            android:textColor="#173B6C"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etGradeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter grade and section"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Age"
            android:textColor="#173B6C"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter age"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Number"
            android:textColor="#173B6C"
            android:textSize="15sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter contact number"
            android:inputType="phone"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:backgroundTint="#173B6C"
            android:text="Register Student"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#173B6C"
            android:text="Back to Home"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:fontFamily="@font/nimbus_roman" />

    </LinearLayout>
</ScrollView>
